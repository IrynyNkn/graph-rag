# Ollama (local LLM runner)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Neo4j (see docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-local

# Vector search (Stage 1). EMBEDDING_DIMENSION must match OLLAMA_EMBEDDING_MODEL's
# actual output size — GraphService refuses to start if it doesn't match an
# already-created index. SIMILARITY_THRESHOLD is uncalibrated; tune it against
# real questions (see configuration.ts).
# EMBEDDING_DIMENSION=768
# SIMILARITY_THRESHOLD=0.6
