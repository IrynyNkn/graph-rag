# Copy to .env. Every value has a default in compose.yaml, so set only what you change.

# Provider: "ollama", or "openai-compatible" for OpenRouter, ChatGPT and the like.
# Ollama runs on the host, because Docker on a Mac has no GPU.
CHAT_PROVIDER=ollama
CHAT_BASE_URL=http://host.docker.internal:11434
# CHAT_API_KEY=

# Each service has its own model, so extraction can use a cheaper one than answers.
INDEXING_CHAT_MODEL=qwen3.5:4b
ASSISTANT_CHAT_MODEL=qwen3.5:4b

# Prompts are budgeted to fit this. Ollama reloads a model when it changes, so keep it the same
# for both services if they share a model.
CHAT_CONTEXT_WINDOW=8192

# OpenRouter example, with embeddings staying local:
# CHAT_PROVIDER=openai-compatible
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_API_KEY=sk-or-...
# INDEXING_CHAT_MODEL=openai/gpt-4o-mini
# ASSISTANT_CHAT_MODEL=openai/gpt-4o-mini
# CHUNK_CONCURRENCY=4

# Changing the embedding model means reindexing, and the dimension must match the model.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
# Some models need task prefixes, such as "search_document: " and "search_query: " for nomic.
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_QUERY_PREFIX=

# OpenRouter example for embeddings too, so that Ollama is not needed at all:
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=sk-or-...
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# The UI is at http://localhost:8080, and the Neo4j browser at http://localhost:7474.
# FRONTEND_PORT=8080
# NEO4J_BROWSER_PORT=7474
# NEO4J_BOLT_PORT=7687
# NEO4J_PASSWORD=graph-rag-local
# POSTGRES_PASSWORD=graph-rag-local
