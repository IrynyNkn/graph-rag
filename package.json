{
  "name": "graph-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^20.19 || >=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && tsc -p apps/frontend/tsconfig.json --noEmit",
    "lint": "oxlint -c oxlint.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project frontend",
    "test:integration": "vitest run --project integration",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  }
}
